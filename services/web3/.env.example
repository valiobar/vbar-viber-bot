# Web3 Service Environment Variables

# ============================================
# Node Environment
# ============================================
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
# HTTP server port (default: 3004)
PORT=3004
# gRPC server port (default: 50052)
GRPC_PORT=50052

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection URI
# Format: mongodb://username:password@host:port/database?authSource=admin
# Default: mongodb://web3:web3123@localhost:27019/web3?authSource=admin
MONGODB_URI=mongodb://web3:web3123@localhost:27019/web3?authSource=admin
# MongoDB database name (default: web3)
MONGODB_DB_NAME=web3

# ============================================
# RabbitMQ Configuration
# ============================================
# RabbitMQ connection URI
# Can use either RABBITMQ_URI or RABBITMQ_URL (RABBITMQ_URL takes precedence)
# Default: amqp://admin:admin@localhost:5672
RABBITMQ_URI=amqp://admin:admin@localhost:5672
# RABBITMQ_URL=amqp://admin:admin@localhost:5672

# ============================================
# Web3 Encryption Key (REQUIRED)
# ============================================
# Encryption key for encrypting sensitive data like private keys
# MUST be at least 32 characters long
# Generate a secure random key for production use
WEB3_ENCRYPTION_KEY=your-encryption-key-here-must-be-at-least-32-characters-long-for-security

# ============================================
# Service Token Configuration
# ============================================
# Service tokens are used for service-to-service authentication
# At least one service token must be configured
# These tokens should match the tokens configured in other services
SERVICE_TOKEN=your-general-service-token-here
ADMIN_SERVICE_TOKEN=your-admin-service-token-here
VIBER_SERVICE_TOKEN=your-viber-service-token-here
AI_SERVICE_TOKEN=your-ai-service-token-here
ANALYTICS_SERVICE_TOKEN=your-analytics-service-token-here
WEB3_SERVICE_TOKEN=your-web3-service-token-here

# ============================================
# Feature Flags
# ============================================
# Enable/disable specific Web3 features
# All features are enabled by default (true)
WEB3_FEATURE_WALLET_CREATION=true
WEB3_FEATURE_TRANSACTION_SIGNING=true
WEB3_FEATURE_CONTRACT_INTERACTION=true
WEB3_FEATURE_NFT_OPERATIONS=true

# ============================================
# Rate Limiting Configuration
# ============================================
# Maximum requests per minute (default: 60)
WEB3_RATE_LIMIT_PER_MINUTE=60
# Maximum requests per hour (default: 1000)
WEB3_RATE_LIMIT_PER_HOUR=1000

# ============================================
# Blockchain RPC Configuration
# ============================================
# RPC URLs for blockchain networks
# Supports comma-separated values for fallback endpoints
# Example: WEB3_RPC_ETHEREUM=https://eth.llamarpc.com,https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Ethereum Mainnet (Chain ID: 1)
# Default: https://eth.llamarpc.com
WEB3_RPC_ETHEREUM=https://eth.llamarpc.com

# Polygon Mainnet (Chain ID: 137)
# Default: https://polygon.llamarpc.com
WEB3_RPC_POLYGON=https://polygon.llamarpc.com

# Binance Smart Chain (Chain ID: 56)
# Default: https://bsc-dataseed1.binance.org
WEB3_RPC_BSC=https://bsc-dataseed1.binance.org

# Arbitrum One (Chain ID: 42161)
# Default: https://arb1.arbitrum.io/rpc
WEB3_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
