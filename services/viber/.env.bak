# =============================================================================
# Viber Service Environment Configuration
# =============================================================================
# Copy this file and update the values according to your environment.
# Never commit this file with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js Environment
# -----------------------------------------------------------------------------
# Environment mode: development, production, or test
NODE_ENV=development

# Service port (default: 3001)
PORT=3001

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URI
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Default: mongodb://localhost:27017
MONGODB_URI=mongodb://bot:bot123@localhost:27017/bot

# MongoDB database name (default: bot)
MONGODB_DB_NAME=bot

# -----------------------------------------------------------------------------
# RabbitMQ Configuration
# -----------------------------------------------------------------------------
# RabbitMQ connection URI
# Format: amqp://[username:password@]host[:port][/vhost]
# Default: amqp://localhost:5672
RABBITMQ_URI=amqp://localhost:5672

# -----------------------------------------------------------------------------
# Viber Bot Configuration
# -----------------------------------------------------------------------------
# Viber bot authentication token (REQUIRED)
# Get this from the Viber Developer Portal: https://developers.viber.com/
VIBER_BOT_TOKEN=4db88e741ca7d2b8-3ca68e24adfcca56-1948d3a5055b5620
WEB3_SERVICE_TOKEN=901f8527c49818197055ea80bbde7f47ae758d19a4faf253960a990079c8e07f
# Viber webhook URL (REQUIRED)
# Public URL where Viber will send webhook events
# Example: https://your-domain.com/api/viber/webhook
# For local development with ngrok: https://your-ngrok-url.ngrok.io/api/viber/webhook
VIBER_BOT_WEBHOOK_URL=https://b700bcf52654.ngrok-free.app/webhook/viber

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# General rate limit: max requests per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=1000

# Health check rate limit: max requests per window per IP (default: 10)
# Stricter limit for health check endpoints
RATE_LIMIT_HEALTH_MAX=10

# Webhook rate limit: max requests per window per IP (default: 1000)
# Higher limit for Viber webhook routes (Viber can send many events)
RATE_LIMIT_WEBHOOK_MAX=1000

# Service-to-service rate limit: max requests per window per service token (default: 5000)
# Highest limit for internal service-to-service communication
RATE_LIMIT_SERVICE_MAX=5000

# Service Token Authentication (should match VIBER_SERVICE_TOKEN in admin service)
ADMIN_SERVICE_TOKEN=8fda459f68ff833eaf6f08f90328e1194dfdbbd4c545ebfb6f0d2a4ae1cfbace
