{
  "name": "@vbar/ai",
  "version": "1.0.0",
  "description": "AI service for Viber bot - Node.js Express service with gRPC support",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
