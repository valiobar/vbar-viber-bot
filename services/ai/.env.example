# AI Service Environment Variables

# Server Configuration
PORT=3002
GRPC_PORT=50051
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://admin:admin123@localhost:27017/ai
MONGODB_DB_NAME=ai

# Message Queue Configuration
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# AI Provider Configuration
# Options: ollama, openai, anthropic, google
AI_MODEL_PROVIDER=ollama
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=

# Conversation Memory Configuration
# Options: buffer, summary
CONVERSATION_MEMORY_TYPE=buffer
CONVERSATION_MAX_HISTORY=10

# Task Type Configuration
# Options: simple, rag, custom
AI_TASK_TYPE=simple

# Ollama Configuration (Self-Hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI Configuration
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-opus

# Google AI Configuration
# GOOGLE_AI_API_KEY=your-google-ai-api-key-here
# GOOGLE_AI_MODEL=gemini-pro

# RAG (Retrieval Augmented Generation) Configuration
RAG_ENABLED=false
RAG_EMBEDDING_PROVIDER=openai
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE_TYPE=mongodb
RAG_VECTOR_STORE_COLLECTION=embeddings
RAG_RETRIEVER_K=4
RAG_SIMILARITY_THRESHOLD=0.7

# Prompt Template Configuration
PROMPT_TEMPLATES_ENABLED=true
PROMPT_TEMPLATE_STORAGE=mongodb
PROMPT_TEMPLATE_DEFAULT=

# Bulgarian Culture Prompt Template
# Name of the prompt template to use for Bulgarian culture context (default: bulgarian_culture_system)
# This template is automatically initialized on service startup
BULGARIAN_CULTURE_PROMPT_TEMPLATE=bulgarian_culture_system

# LangSmith Observability (Optional)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=your-project-name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
