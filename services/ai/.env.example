# =============================================================================
# AI Service Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values
# cp .env.example .env

# =============================================================================
# Service Configuration
# =============================================================================

# Server port (default: 3002)
PORT=3002

# gRPC server port (default: 50051)
GRPC_PORT=50051

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name (default: ai)
MONGODB_DB_NAME=ai

# RabbitMQ connection string
RABBITMQ_URI=amqp://localhost:5672

# =============================================================================
# AI Provider Configuration
# =============================================================================

# AI model provider to use: openai, ollama, anthropic, google (default: openai)
AI_MODEL_PROVIDER=openai

# Temperature for AI responses (0.0 to 2.0, default: 0.7)
# Higher values make output more random, lower values make it more focused
AI_TEMPERATURE=0.7

# Maximum tokens for AI responses (optional)
# Leave empty for provider default
AI_MAX_TOKENS=

# =============================================================================
# Conversation Memory Configuration
# =============================================================================

# Conversation memory type: buffer, summary (default: buffer)
# - buffer: Stores all messages (good for short conversations)
# - summary: Summarizes older messages (good for long conversations)
CONVERSATION_MEMORY_TYPE=buffer

# Maximum number of messages to keep in conversation history (default: 10)
CONVERSATION_MAX_HISTORY=10

# =============================================================================
# OpenAI Configuration
# =============================================================================

# OpenAI API key (required if AI_MODEL_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model name (default: gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview, etc.
OPENAI_MODEL=gpt-3.5-turbo

# =============================================================================
# Ollama Configuration
# =============================================================================

# Ollama base URL (default: http://localhost:11434)
# Change if Ollama is running on a different host/port
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (default: llama2)
# Options: llama2, mistral, codellama, etc.
# Make sure the model is pulled: ollama pull llama2
OLLAMA_MODEL=llama2

# =============================================================================
# Anthropic Configuration
# =============================================================================

# Anthropic API key (required if AI_MODEL_PROVIDER=anthropic)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Anthropic model name (optional, uses default if not specified)
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
ANTHROPIC_MODEL=

# =============================================================================
# Google AI Configuration
# =============================================================================

# Google AI API key (required if AI_MODEL_PROVIDER=google)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Google AI model name (default: gemini-pro)
# Options: gemini-pro, gemini-pro-vision
GOOGLE_AI_MODEL=gemini-pro

# =============================================================================
# LangSmith Configuration (Observability & Tracing)
# =============================================================================

# Enable LangSmith tracing (default: false)
# Set to true to enable automatic tracing of LangChain operations
# LangSmith provides observability, debugging, and evaluation capabilities
LANGSMITH_TRACING=false

# LangSmith API key (required if LANGSMITH_TRACING=true)
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here

# LangSmith project name (optional)
# Organize traces by project name in LangSmith dashboard
# If not set, uses default project
LANGSMITH_PROJECT=ai-service

# LangSmith endpoint (optional, default: https://api.smith.langchain.com)
# Use custom endpoint for self-hosted LangSmith instances
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# Task Type Configuration
# =============================================================================

# Default task type for message processing: simple, rag, custom (default: simple)
# - simple: Direct prompt to AI model (no RAG)
# - rag: Retrieval Augmented Generation (uses vector store)
# - custom: Custom chain defined in prompt template
AI_TASK_TYPE=simple

# =============================================================================
# RAG (Retrieval Augmented Generation) Configuration
# =============================================================================

# Enable RAG for knowledge-based responses (default: false)
# When enabled, uses vector store to retrieve relevant context before generating response
RAG_ENABLED=false

# Embedding provider for RAG: openai, ollama, local (default: openai)
# - openai: OpenAI embeddings (text-embedding-ada-002 or text-embedding-3-small)
# - ollama: Ollama embeddings (nomic-embed-text)
# - local: Local embeddings (if available)
RAG_EMBEDDING_PROVIDER=openai

# OpenAI embedding model (default: text-embedding-3-small)
# Options: text-embedding-ada-002, text-embedding-3-small, text-embedding-3-large
# Required if RAG_EMBEDDING_PROVIDER=openai
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama embedding model (default: nomic-embed-text)
# Options: nomic-embed-text, all-minilm
# Required if RAG_EMBEDDING_PROVIDER=ollama
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector store type: mongodb, memory (default: mongodb)
# - mongodb: MongoDB Atlas Vector Search (requires vector search index)
# - memory: In-memory vector store (not persistent)
RAG_VECTOR_STORE_TYPE=mongodb

# MongoDB collection name for vector store (default: embeddings)
RAG_VECTOR_STORE_COLLECTION=embeddings

# Number of documents to retrieve for RAG context (default: 4)
RAG_RETRIEVER_K=4

# Similarity search threshold (0.0 to 1.0, default: 0.7)
# Only retrieve documents with similarity score above this threshold
RAG_SIMILARITY_THRESHOLD=0.7

# =============================================================================
# Prompt Engineering Configuration
# =============================================================================

# Enable prompt template management (default: true)
PROMPT_TEMPLATES_ENABLED=true

# Prompt template storage type: mongodb, file (default: mongodb)
# - mongodb: Store templates in MongoDB (recommended for production)
# - file: Store templates in filesystem (for development)
PROMPT_TEMPLATE_STORAGE=mongodb

# Default prompt template name (optional)
# If not specified, uses system default prompt
PROMPT_TEMPLATE_DEFAULT=default

# Prompt template directory (if using file storage)
# PROMPT_TEMPLATE_DIR=./prompts
