# Example Secrets file - DO NOT commit actual secrets to version control
# Copy this file to secrets.yaml and fill in actual values
# Then apply: kubectl apply -f infrastructure/k8s/secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: vbar-secrets
  namespace: vbar-viber-bot
  labels:
    app: vbar-viber-bot
type: Opaque
stringData:
  # MongoDB Credentials (if authentication is enabled)
  MONGODB_ADMIN_USER: "admin"
  MONGODB_ADMIN_PASSWORD: "change-me"
  MONGODB_BOT_USER: "bot"
  MONGODB_BOT_PASSWORD: "change-me"
  MONGODB_AI_USER: "ai"
  MONGODB_AI_PASSWORD: "change-me"
  MONGODB_ANALYTICS_USER: "analytics"
  MONGODB_ANALYTICS_PASSWORD: "change-me"
  
  # RabbitMQ Credentials
  RABBITMQ_USER: "admin"
  RABBITMQ_PASSWORD: "change-me"
  RABBITMQ_URL: "amqp://admin:change-me@rabbitmq:5672"
  
  # Viber Bot Configuration
  VIBER_BOT_TOKEN: "your-viber-bot-token-here"
  VIBER_WEBHOOK_URL: "https://your-domain.com/api/viber/webhook"
  
  # External AI API Keys (optional)
  OPENAI_API_KEY: "your-openai-api-key-here"
  ANTHROPIC_API_KEY: "your-anthropic-api-key-here"
  
  # JWT Secret (if used for authentication)
  JWT_SECRET: "your-jwt-secret-here"
  
  # Other secrets
  SESSION_SECRET: "your-session-secret-here"

---
# RabbitMQ Secret (separate for clarity)
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secret
  namespace: vbar-viber-bot
  labels:
    app: rabbitmq
type: Opaque
stringData:
  username: "admin"
  password: "change-me"
  url: "amqp://admin:change-me@rabbitmq:5672"








