# Docker Compose Override Example
# Copy this file to docker-compose.override.yml and customize for local development.
# This file is automatically loaded by docker compose when present.
#
# Security Model:
# - Admin and Viber: publicly accessible (0.0.0.0) — Admin for UI, Viber for webhooks
# - AI: localhost only (127.0.0.1) — internal
# - Mongo/RabbitMQ: localhost only (set in main compose)
#
# Optional profiles:
# - local-llm: Ollama (docker compose --profile local-llm up -d)

version: '3.8'

services:
  admin:
    build:
      context: ..
      dockerfile: services/admin/Dockerfile
    environment:
      - NODE_ENV=development
      - MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongodb:27017/admin_service?authSource=admin
      - MONGODB_DB_NAME=admin_service
      - RABBITMQ_URI=${RABBITMQ_URI}
      - VIBER_SERVICE_TOKEN=${VIBER_SERVICE_TOKEN}
      - ADMIN_SERVICE_TOKEN=${ADMIN_SERVICE_TOKEN}
      - SERVICE_TOKEN=${SERVICE_TOKEN}
      - JWT_SECRET=${JWT_SECRET}
      - BOT_TOKEN_ENCRYPTION_KEY=${BOT_TOKEN_ENCRYPTION_KEY}

  # Viber must remain publicly accessible for webhook callbacks
  viber:
    build:
      context: ..
      dockerfile: services/viber/Dockerfile
    environment:
      - NODE_ENV=development
      - PORT=3001
      - MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongodb:27017/bot?authSource=admin
      - MONGODB_DB_NAME=bot
      - RABBITMQ_URI=${RABBITMQ_URI}
      - VIBER_BOT_TOKEN=${VIBER_BOT_TOKEN}
      - VIBER_BOT_WEBHOOK_URL=${VIBER_BOT_WEBHOOK_URL}
      - ADMIN_SERVICE_URL=http://admin:3000
      - ADMIN_SERVICE_TOKEN=${ADMIN_SERVICE_TOKEN}
      - AI_SERVICE_GRPC_HOST=ai
      - AI_SERVICE_GRPC_PORT=50051
      - SERVICE_TOKEN=${SERVICE_TOKEN}

  ai:
    build:
      context: ..
      dockerfile: services/ai/Dockerfile
    environment:
      - NODE_ENV=development
      - PORT=3002
      - GRPC_PORT=50051
      - MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongodb:27017/ai?authSource=admin
      - MONGODB_DB_NAME=ai
      - OLLAMA_BASE_URL=${OLLAMA_BASE_URL:-http://ollama:11434}
      - AI_MODEL_PROVIDER=${AI_MODEL_PROVIDER:-ollama}
      - OLLAMA_MODEL=${OLLAMA_MODEL:-llama2}

  mongodb:
    # Port already 127.0.0.1:27017 in main compose
    # volumes:
    #   - ./data/mongodb:/data/db

  rabbitmq:
    # Ports already 127.0.0.1:5672 / 127.0.0.1:15672 in main compose
    # Management UI: http://127.0.0.1:15672 (or SSH tunnel on VPS)

  ollama:
    # Requires --profile local-llm; port 127.0.0.1:11434
    # deploy:
    #   resources:
    #     reservations:
    #       devices:
    #         - driver: nvidia
    #           count: 1
    #           capabilities: [gpu]
