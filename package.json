{
  "name": "vbar-viber-bot",
  "version": "1.0.0",
  "description": "Microservices architecture for Viber bot with Admin, Viber, and AI services",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared && npm run build --workspaces",
    "build:admin": "npm run build --workspace=services/admin",
    "build:viber": "npm run build --workspace=services/viber",
    "build:ai": "npm run build --workspace=services/ai",
    "build:shared": "npm run build --workspace=packages/shared",
    "dev": "npm run dev --workspaces --if-present",
    "dev:admin": "npm run dev --workspace=services/admin",
    "dev:viber": "npm run dev --workspace=services/viber",
    "dev:ai": "npm run dev --workspace=services/ai",
    "test": "npm run test --workspaces --if-present",
    "test:admin": "npm run test --workspace=services/admin",
    "test:viber": "npm run test --workspace=services/viber",
    "test:ai": "npm run test --workspace=services/ai",
    "test:shared": "npm run test --workspace=packages/shared",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install",
    "docker:build": "docker compose --env-file .env -f infrastructure/docker-compose.yml build",
    "docker:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up",
    "docker:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f",
    "docker:pull": "docker compose --env-file .env -f infrastructure/docker-compose.yml pull"
  },
  "keywords": [
    "microservices",
    "viber",
    "bot",
    "nextjs",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "glob": ">=10.5.0"
  },
  "packageManager": "yarn@1.22.22+sha256.c17d3797fb9a9115bf375e31bfd30058cac6bc9c3b8807a3d8cb2094794b51ca"
}
