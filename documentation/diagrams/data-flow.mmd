    classDef ext fill:#FFD93D,stroke:#333,stroke-width:2px,color:#000

    class Admin,Viber,AI,Route svc
    class Mongo,Chroma db
    class RabbitMQ mq
    class User,AdminUser,ViberAPI,ExternalAI,Ollama ext
