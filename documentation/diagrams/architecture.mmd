flowchart TB
    ViberAPI[Viber API]
    Users[Admin users]
    ExternalAI[Cloud LLMs<br/>OpenAI / Anthropic / Google]
    Ollama[Ollama<br/>profile local-llm]
    SharedPackage["@vbar/shared<br/>types, config, infra"]

    subgraph AdminService["Admin :3000"]
        AdminIn[App Router API]
        AdminApp[Services + FSD CMS]
        AdminOut[Mongo + MQ publisher]
        AdminIn --> AdminApp --> AdminOut
    end

    subgraph ViberService["Viber :3001"]
        ViberIn[Webhook]
        ViberApp[Steps / messaging]
        ViberOut[Admin client + AI gRPC + MQ consumer]
        ViberIn --> ViberApp --> ViberOut
    end

    subgraph AIService["AI :3002 / gRPC 50051"]
        AIIn[gRPC ProcessMessage]
        AIHttp[HTTP /api/knowledge-base]
        AIApp[LangChain / providers]
        AIOut[Mongo + optional Chroma + LLM]
        AIIn --> AIApp --> AIOut
        AIHttp --> AIApp
    end

    Mongo[(Shared MongoDB<br/>admin_service / bot / ai)]
    Chroma[(Chroma embeddings)]
    RabbitMQ[RabbitMQ<br/>exchange viber-bot<br/>queue viber.refresh]

    Users -->|HTTPS/HTTP| AdminIn
    ViberAPI -->|POST/GET /webhook/viber| ViberIn

    AdminOut -->|Read/Write| Mongo
    ViberOut -->|Read/Write| Mongo
    AIOut -->|Read/Write| Mongo
    AIOut -.->|optional RAG| Chroma

    AdminOut -->|publish viber.refresh| RabbitMQ
    RabbitMQ -->|consume| ViberOut

    ViberOut -->|REST + service token| AdminIn
    ViberOut -->|gRPC ProcessMessage| AIIn
    AdminApp -->|REST + X-Service-Token| AIHttp

    AIOut -.->|optional| Ollama
    AIOut -.->|optional| ExternalAI

    AdminApp -.->|imports| SharedPackage
    ViberApp -.->|imports| SharedPackage
    AIApp -.->|imports| SharedPackage

    classDef serviceBox fill:#4ECDC4,stroke:#333,stroke-width:2px,color:#000
    classDef dbBox fill:#95E1D3,stroke:#333,stroke-width:2px,color:#000
    classDef mqBox fill:#F38181,stroke:#333,stroke-width:2px,color:#000
    classDef externalBox fill:#AA96DA,stroke:#333,stroke-width:2px,color:#000

    class AdminIn,AdminApp,AdminOut,ViberIn,ViberApp,ViberOut,AIIn,AIHttp,AIApp,AIOut,Ollama serviceBox
    class Mongo,Chroma dbBox
    class RabbitMQ mqBox
    class ViberAPI,Users,ExternalAI,SharedPackage externalBox
