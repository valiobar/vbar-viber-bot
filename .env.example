# Root Environment Variables Template
# Copy this file to .env and fill in the actual values
# Each service has its own .env.example file with service-specific variables

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB Authentication Credentials
# These credentials are used by Docker Compose to initialize MongoDB instances
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=admin123
MONGO_BOT_USER=bot
MONGO_BOT_PASS=bot123
MONGO_AI_USER=ai
MONGO_AI_PASS=ai123
MONGO_ANALYTICS_USER=analytics
MONGO_ANALYTICS_PASS=analytics123

# Admin Service Database
# Format: mongodb://username:password@host:port/database
MONGODB_ADMIN_URI=mongodb://admin:admin123@localhost:27017/admin
MONGODB_ADMIN_DB_NAME=admin

# Viber Service Database
MONGODB_VIBER_URI=mongodb://bot:bot123@localhost:27018/bot
MONGODB_VIBER_DB_NAME=bot

# AI Service Database
MONGODB_AI_URI=mongodb://ai:ai123@localhost:27019/ai
MONGODB_AI_DB_NAME=ai

# Analytics Service Database
MONGODB_ANALYTICS_URI=mongodb://analytics:analytics123@localhost:27020/analytics
MONGODB_ANALYTICS_DB_NAME=analytics

# ============================================
# Message Queue Configuration (RabbitMQ)
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/
RABBITMQ_URI=amqp://admin:admin@localhost:5672/

# ============================================
# Service Ports
# ============================================
ADMIN_PORT=3000
VIBER_PORT=3001
AI_PORT=3002
ANALYTICS_PORT=3003

# ============================================
# Service URLs (for inter-service communication)
# ============================================
ADMIN_URL=http://localhost:3000
VIBER_URL=http://localhost:3001
AI_URL=http://localhost:3002
ANALYTICS_URL=http://localhost:3003

# ============================================
# Viber Bot Configuration
# ============================================
VIBER_BOT_TOKEN=your_viber_bot_token_here
VIBER_WEBHOOK_URL=https://your-domain.com/viber/webhook

# ============================================
# AI Service Configuration
# ============================================
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4
AI_MAX_TOKENS=1000

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
API_KEY=your_api_key_here

# ============================================
# Environment
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Docker Configuration
# ============================================
# MongoDB URIs for Docker Compose (using service names as hosts)
# Format: mongodb://username:password@service-name:port/database
# MONGODB_ADMIN_URI=mongodb://admin:admin123@mongodb-admin:27017/admin
# MONGODB_VIBER_URI=mongodb://bot:bot123@mongodb-bot:27017/bot
# MONGODB_AI_URI=mongodb://ai:ai123@mongodb-ai:27017/ai
# MONGODB_ANALYTICS_URI=mongodb://analytics:analytics123@mongodb-analytics:27017/analytics
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_URI=amqp://admin:admin@rabbitmq:5672/
