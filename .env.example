# Single system environment file
# Copy to .env and fill in real values. Never commit .env.
# Used by: Docker Compose, deploy.sh, and local npm (admin/viber/ai).
# On the VPS create .env once; CI only updates IMAGE_TAG.

# ============================================
# Image tag (CI sets this on deploy; local builds use :latest)
# ============================================
IMAGE_TAG=latest

# ============================================
# Runtime
# ============================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# MongoDB (single shared instance)
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-strong-password

# Host/local npm: point at localhost. Compose overrides URI inside containers.
# Leave MONGODB_DB_NAME unset so each service uses its default
# (admin_service / bot / ai).
MONGODB_URI=mongodb://admin:change-me-strong-password@localhost:27017/?authSource=admin

# ============================================
# RabbitMQ (required — no insecure defaults)
# ============================================
RABBITMQ_USER=vbar
RABBITMQ_PASS=change-me-rabbit-password
# Host/local npm URI (localhost). Compose injects rabbitmq-hostname URI into containers.
RABBITMQ_URI=amqp://vbar:change-me-rabbit-password@localhost:5672

# ============================================
# Viber Bot
# ============================================
VIBER_BOT_TOKEN=your_viber_bot_token_here
# Public HTTPS URL Viber calls (ngrok / reverse proxy)
VIBER_BOT_WEBHOOK_URL=https://your-domain.com/webhook/viber
# Optional fallback used when building webhook URLs
# PUBLIC_URL=https://your-domain.com

# ============================================
# Service Tokens (service-to-service auth)
# Viber sends ADMIN_SERVICE_TOKEN (falls back to VIBER_SERVICE_TOKEN, then SERVICE_TOKEN).
# Admin accepts SERVICE_TOKEN, ADMIN_SERVICE_TOKEN, VIBER_SERVICE_TOKEN, and AI_SERVICE_TOKEN.
# Distinct values are fine as long as the token Viber sends is one Admin allowlists.
# ============================================
SERVICE_TOKEN=change-me-service-token
ADMIN_SERVICE_TOKEN=change-me-service-token
VIBER_SERVICE_TOKEN=change-me-service-token
AI_SERVICE_TOKEN=change-me-service-token

# ============================================
# Admin (JWT + bot-token encryption)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BOT_TOKEN_ENCRYPTION_KEY=change-me-bot-token-encryption-key-32b

# Local npm inter-service URLs (Compose uses service DNS names instead)
ADMIN_SERVICE_URL=http://localhost:3000
VIBER_SERVICE_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:3002

# ============================================
# Viber rate limits (optional — defaults shown)
# ============================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_HEALTH_MAX=10
# RATE_LIMIT_WEBHOOK_MAX=1000
# RATE_LIMIT_SERVICE_MAX=5000

# ============================================
# AI Service
# ============================================
# openai | ollama | anthropic | google
AI_MODEL_PROVIDER=ollama
AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=
AI_TASK_TYPE=simple

# Conversation memory: buffer | summary
CONVERSATION_MEMORY_TYPE=buffer
CONVERSATION_MAX_HISTORY=10

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- Ollama (local / --profile local-llm) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Google AI ---
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-pro

# --- LangSmith (optional) ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-service
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- RAG (optional) ---
# Persistent store is Chroma. Start it with: docker compose --profile rag up -d
# Host npm: CHROMA_URL=http://localhost:8000
# Compose: CHROMA_URL=http://chromadb:8000 (set automatically on the ai service)
RAG_ENABLED=false
RAG_EMBEDDING_PROVIDER=openai
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE_TYPE=chroma
CHROMA_URL=http://localhost:8000
RAG_VECTOR_STORE_COLLECTION=embeddings
RAG_RETRIEVER_K=4
RAG_SIMILARITY_THRESHOLD=0.7

# --- Knowledge base ingest ---
# AI_SERVICE_TOKEN (tokens block above) must match between admin (outbound) and ai (inbound)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
INGEST_MAX_URLS=20
INGEST_MAX_FILE_SIZE_MB=10
# INGEST_URL_TIMEOUT_MS=15000

# --- Prompt templates ---
PROMPT_TEMPLATES_ENABLED=true
PROMPT_TEMPLATE_STORAGE=mongodb
# PROMPT_TEMPLATE_DEFAULT=default
# BULGARIAN_CULTURE_PROMPT_TEMPLATE=bulgarian_culture_system

