{
  "name": "@vbar/shared",
  "version": "1.0.0",
  "description": "Shared utilities, types, and configurations for Viber bot microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "default": "./dist/infra/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "infra": ["./dist/infra/index.d.ts"]
    }
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "keywords": [
    "shared",
    "types",
    "utilities",
    "microservices"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "mongoose": "^9.0.1"
  }
}




